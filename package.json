{
  "name": "chaoxing-helper",
  "version": "1.1.0",
  "description": "超星学习通助手集 - 代码编辑器增强和自动发帖功能",
  "main": "index.js",
  "scripts": {
    "lint": "eslint src/",
    "format": "prettier --write src/**/*.js",
    "build": "node scripts/build.js",
    "build:version": "node scripts/build.js --version",
    "prepare": "node -e \"const fs=require('fs'),p=require('path');const s=p.join('scripts','hooks','pre-commit');const d=p.join('.git','hooks','pre-commit');if(fs.existsSync(s)){fs.copyFileSync(s,d);console.log('pre-commit hook installed')}else{console.log('skipped')}\""
  },
  "keywords": [
    "tampermonkey",
    "chaoxing",
    "学习通",
    "userscript"
  ],
  "author": "Lumjiel",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.0.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.0.0"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "greasemonkey": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": 2021
    },
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "off"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "none"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
