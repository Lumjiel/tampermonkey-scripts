#!/bin/sh
# pre-commit hook：自动对暂存的 JS 文件运行 eslint --fix 和 prettier
# 安装方式：npm run prepare（首次 clone 后执行）

# 获取暂存区中的 JS 文件
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.js$' | grep '^src/')

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

echo "[pre-commit] 检查: $STAGED_FILES"

# 对暂存区内容运行 lint（使用 --quiet 减少输出，只显示错误）
npx eslint --quiet $STAGED_FILES
if [ $? -ne 0 ]; then
    echo "[pre-commit] ❌ eslint 发现错误，请修复后重新 commit"
    exit 1
fi

# 对暂存区内容运行 format
npx prettier --write $STAGED_FILES
# 将格式化后的结果重新加入暂存区
git add $STAGED_FILES

echo "[pre-commit] ✅ 检查通过"
